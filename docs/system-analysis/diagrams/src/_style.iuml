!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #465B75
skinparam LineColor #465B75
skinparam RoundCorner 10
skinparam Padding 8
skinparam maxMessageSize 75
skinparam sequenceMessageAlign center
skinparam packageStyle rectangle
skinparam noteBackgroundColor #FFF5D6
skinparam noteBorderColor #D7AD52
skinparam rectangleBackgroundColor #F0F5FC
skinparam rectangleBorderColor #54749B
skinparam componentBackgroundColor #F0F5FC
skinparam componentBorderColor #54749B
skinparam classBackgroundColor #F0F5FC
skinparam classBorderColor #54749B
skinparam usecaseBackgroundColor #EDF7F3
skinparam usecaseBorderColor #34745A
skinparam activityBackgroundColor #F0F5FC
skinparam activityBorderColor #54749B
skinparam stateBackgroundColor #EDF7F3
skinparam stateBorderColor #34745A
skinparam titleFontSize 20
skinparam titleFontColor #183A58
hide footbox
