# ══════════════════════════════════════════════
#  Deep Research Agent — Environment Variables
# ══════════════════════════════════════════════

# ── LLM (Google Gemini) ──
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004

# ── Search APIs ──
TAVILY_API_KEY=your_tavily_api_key_here

# ── Qdrant (Vector DB) ──
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_knowledge_base

# ── Neo4j (Graph DB) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mowsis_dev_2026

# ── PostgreSQL ──
POSTGRES_URL=postgresql://mowsis:mowsis_dev_2026@localhost:5432/mowsis_db

# ── App Settings ──
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── Budget Defaults ──
MAX_LOOPS=3
MAX_TAVILY_CALLS=4
MAX_SCHOLAR_CALLS=6
MAX_DOCUMENTS_TO_READ=8
MAX_TOTAL_INPUT_TOKENS=150000
